{
  "name": "gemini-flash-api",
  "version": "1.0.0",
  "description": "Express.js API integrating Gemini AI",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./services/text": "./src/services/textService.js",
    "./services/image": "./src/services/imageService.js",
    "./services/document": "./src/services/documentService.js",
    "./services/audio": "./src/services/audioService.js",
    "./app": "./src/app.js"
  },
  "files": [
    "src",
    "README.md",
    "GEMINI.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --input-type=module -e \"import * as sdk from './src/index.js'; console.log('SDK exports test passed:', Object.keys(sdk));\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.23.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  }
}
