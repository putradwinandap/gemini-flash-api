{
  "name": "gemini-flash-api",
  "version": "2.0.0",
  "description": "Express.js API integrating Gemini AI",
  "main": "src/index.js",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./services/text": "./src/services/textService.js",
    "./services/image": "./src/services/imageService.js",
    "./services/document": "./src/services/documentService.js",
    "./services/audio": "./src/services/audioService.js",
    "./app": "./src/app.js"
  },
  "files": [
    "src",
    "README.md",
    "GEMINI.md"
  ],
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:write": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "verify": "npm run format:check && npm run lint && npm test && npm audit --audit-level=high",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@google/genai": "^2.23.0",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "supertest": "^7.2.2"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ]
  }
}
