PORT=3000
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_MS=60000
# Server-side memory: true = auto-remember (enables previousInteractionId chaining).
# ONLY editable via ENV or code config { store }. Never via endpoint request body.
GEMINI_STORE=true
NODE_ENV=development
